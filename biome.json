{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "overrides": [
    {
      "include": ["test/**/*.ts", "test/**/*.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "files": {
    "include": [
      "src/**/*.ts",
      "test/**/*.ts",
      "test/**/*.mjs",
      "harness/**/*.ts",
      "scripts/**/*.mjs",
      "scripts/**/*.mts",
      "*.mjs",
      "*.mts",
      "*.ts",
      "*.json"
    ],
    "ignore": ["dist", "node_modules", ".tmp", "harness/blazor-host/StudioHost"]
  }
}
